      "must_not": [
        "viz-web"
      ],
      "why": "认知层规划 + 静态图 + 报告排版交接。"
    },
    {
      "id": "R07",
      "task_id": "07-academic-forest",
      "prompt": "把 A/B 实验按渠道汇总成森林图，双栏、95% CI、n、汇总菱形，适合期刊投稿。",
