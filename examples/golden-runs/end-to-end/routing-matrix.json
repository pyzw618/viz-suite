{
  "version": "1.0",
  "description_changes": [
    "10 个 SKILL.md 的 description 增加“不用于截图逆向（用 viz-reverse）”边界，避免与正向引擎混淆。",
    "viz-reverse description 增加“不用于正向绘图/看板/信息图（用对应引擎）”，并保留登录/付费墙/版权的负向边界。",
    "viz-audit 明确不用于逆向数据提取；场景模块明确不用于截图逆向。"
  ],
  "cases": [
    {
      "id": "R01",
      "task_id": "01-academic-multipanel",
      "prompt": "把三组前后测实验数据做成期刊双栏三面板图，均值 95% CI、趋势带、配对变化，注明 n/CI，不编造显著性。",
      "expected": {
        "primary": "viz-python",
        "scenes": [
          "viz-scene-academic"
        ],
        "support": [
          "viz-audit"
        ]
      },
      "must_not": [
        "viz-web",
        "viz-infographic"
      ],
      "why": "静态出版图 + academic 12 槽位 + 物理/视觉验收。"
    },
    {
      "id": "R02",
      "task_id": "02-sales-dashboard",
      "prompt": "用经营数据做可筛选月份/渠道的销售驾驶舱，KPI、实际 vs 目标、渠道构成、明细表，桌面和手机都验收。",
      "expected": {
        "primary": "viz-web",
        "scenes": [
          "viz-scene-bi"
        ],
        "support": [
          "viz-audit"
        ]
      },
      "must_not": [
        "viz-python",
        "viz-infographic"
      ],
      "why": "交互/联动 + IBCS 经营看板，需要 HTML 双视口。"
    },
    {
      "id": "R03",
      "task_id": "03-retro-infographic",
      "prompt": "把 2025 上半年复盘做成一页纸信息图，四个核心数字，报刊风格，带来源口径。",
      "expected": {
        "primary": "viz-infographic",
        "scenes": [],
        "support": [
          "viz-web",
          "viz-audit"
        ]
      },
      "must_not": [
        "viz-python"
      ],
      "why": "结构化信息图，不是统计坐标图。"
    },
    {
      "id": "R04",
      "task_id": "04-reverse-rebrand",
      "prompt": "这张别人的柱状图截图，反推数据后换成我们的品牌色重绘，保留数据但不要复制原图风格。",
      "expected": {
        "primary": "viz-reverse",
        "scenes": [],
        "support": [
          "viz-python",
          "viz-audit"
        ]
      },
      "must_not": [
        "viz-web"
      ],
      "why": "先 B 级逆向，再用正向引擎换品牌色；不能直接用截图猜数。"
    },
    {
      "id": "R05",
      "task_id": "05-ugly-chart-fix",
      "prompt": "这张图基线截断、彩虹色、标签旋转、没有来源；诊断并重绘一张可信排序横条图。",
      "expected": {
        "primary": "viz-audit",
        "scenes": [],
        "support": [
          "viz-python",
          "viz-core"
        ]
      },
      "must_not": [
        "viz-reverse"
      ],
      "why": "存量图诊断 + 正向重绘，不是从截图反推原始数据。"
    },
    {
      "id": "R06",
      "task_id": "06-analysis-to-pdf",
      "prompt": "从区域销售表完成统计摘要、图表和两页 PDF，并给 5 页 PPT 交接提纲。",
      "expected": {
        "primary": "viz-core",
        "scenes": [],
        "support": [
          "viz-python",
          "viz-audit",
          "host:pdf",
          "host:pptx"
