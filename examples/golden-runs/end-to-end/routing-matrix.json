  "negative_cases": [
    {
      "id": "N01",
      "prompt": "把这篇论文的森林图改成能筛选月份和渠道的网页看板。",
      "expected_primary": "viz-web",
      "must_not": [
        "viz-python",
        "viz-scene-academic"
      ],
      "why": "最终交互形态是看板；学术场景差分不再适用。"
    },
    {
      "id": "N02",
      "prompt": "用 ECharts 画一张要投期刊的双栏矢量图。",
      "expected_primary": "viz-python",
      "must_not": [
        "viz-web",
        "viz-infographic"
      ],
      "why": "期刊矢量/双栏优先于交互引擎。"
    },
    {
      "id": "N03",
      "prompt": "给这张信息图加一个区域筛选器和 Hover 详情。",
      "expected_primary": "viz-web",
      "must_not": [
