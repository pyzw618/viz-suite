    {
      "id": "R11",
      "task_id": "11-reverse-source-exact",
      "prompt": "从这个本地 ECharts 页面精确提取数据和配置，输出可复现 JS/data.csv，不要像素猜测。",
      "expected": {
        "primary": "viz-reverse",
