    {
      "id": "R10",
      "task_id": "10-technical-infographic",
      "prompt": "把离线可视化管线做成技术风步骤信息图，输出 HTML/SVG，桌面与手机无溢出。",
      "expected": {
        "primary": "viz-infographic",
        "scenes": [],
