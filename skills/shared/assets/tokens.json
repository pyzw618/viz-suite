{
  "schema": "viz-suite.tokens/1",
  "version": "2026.10",
  "description": "viz-suite 全局设计令牌：9 大色彩角色、字体栈、6 套安全版式族、导出物理参数与统计诚实规则。所有引擎默认读取本文件；EXTEND.md 与 figure-manifest.json 可覆盖同一路径下的字段。",
  "colors": {
    "roles": {
      "focal": "#0072B2",
      "context": "#CBD5E1",
      "positive": "#198038",
      "negative": "#DA1E28",
      "alert": "#D97706",
      "grid": "#E2E8F0",
      "background": "#FFFFFF",
      "text": "#1F2937",
      "muted_text": "#6B7280"
    },
    "role_descriptions": {
      "focal": "焦点主色，每张图只允许一个主视觉主角",
      "context": "对比序列的冷灰背景色，用于把非重点系列置灰",
      "positive": "正向达标/增长",
      "negative": "负向异常/下降",
      "alert": "阈值告警与风险标注",
      "grid": "弱网格线，与白底对比度必须 ≤15%",
      "background": "画布底色",
      "text": "主文本、轴标题、刻度",
      "muted_text": "来源注记、单位、次要说明"
    },
    "default_palette": "okabe_ito",
    "palette_by_scene": {
      "academic": "okabe_ito",
      "bi": "bi_ibcs",
      "story": "editorial_warm",
      "geo": "met_egypt",
      "default": "okabe_ito"
    },
    "backgrounds": {
      "white": "#FFFFFF",
      "soft_tint": "#F8FAFC"
    },
    "sequential": {
      "light_mix_ratio": 0.9,
      "note": "由 90% 画布白 + 10% 主题首色的浅端平滑插值至主题首色"
    },
    "diverging": {
      "midpoint": "#FFFFFF",
      "note": "两极取主题首色与当前色板中 CIEDE2000 距离最远的颜色，奇数 LUT 锁死纯白零点"
    }
  },
  "typography": {
    "font_zh": [
      "Microsoft YaHei",
      "PingFang SC",
      "Noto Sans CJK SC",
      "Source Han Sans SC",
      "HarmonyOS Sans SC",
      "SimHei",
      "WenQuanYi Zen Hei",
      "sans-serif"
    ],
    "font_en": [
      "Inter",
      "Arial",
      "Helvetica",
      "Segoe UI",
      "DejaVu Sans"
    ],
    "font_serif_zh": [
      "Source Han Serif SC",
      "Noto Serif CJK SC",
      "SimSun",
      "STSong",
      "serif"
    ],
    "size_pt": {
      "title": 13.0,
      "subtitle": 10.5,
      "axis_label": 10.0,
      "tick": 9.0,
      "legend": 9.0,
      "annotation": 8.5,
      "source": 7.5,
      "panel_label": 12.0
    },
    "font_size_levels": {
      "small": 0.9,
      "regular": 1.0,
      "large": 1.12
    },
    "min_effective_pt": 6.0,
    "line_height": 1.25
  },
  "layout": {
    "families": {
      "clean_open": {
        "description": "极简左下轴，无网格，刻度朝外",
        "spines": ["left", "bottom"],
        "spine_width": 0.9,
        "tick_direction": "out",
        "tick_length": 3.0,
        "grid": "none",
        "canvas": "white",
        "legend_frame": false
      },
      "soft_grid": {
        "description": "仅保留左/下轴，横向柔和虚线网格引导读数",
        "spines": ["left", "bottom"],
        "spine_width": 0.8,
        "tick_direction": "out",
        "tick_length": 3.0,
        "grid": "y",
        "grid_style": "dashed",
        "grid_width": 0.6,
        "grid_color": "#E2E8F0",
        "canvas": "white",
        "legend_frame": false
      },
      "framed_journal": {
        "description": "期刊闭合框，刻度朝内，无背景网格",
        "spines": ["left", "bottom", "top", "right"],
        "spine_width": 0.8,
        "tick_direction": "in",
        "tick_length": 3.5,
        "grid": "none",
        "canvas": "white",
        "legend_frame": false
      },
      "bold_edge": {
        "description": "加重左下轴线与刻度，适合投影汇报",
        "spines": ["left", "bottom"],
        "spine_width": 1.4,
        "tick_width": 1.2,
        "tick_direction": "out",
        "tick_length": 4.0,
        "grid": "none",
        "canvas": "white",
        "legend_frame": false
      },
      "minimal_axis": {
        "description": "仅保留底轴，适合坡度图、哑铃图与直接标注图",
        "spines": ["bottom"],
        "spine_width": 0.8,
        "tick_direction": "out",
        "tick_length": 2.5,
        "grid": "none",
        "canvas": "white",
        "legend_frame": false
      },
      "panel_tint": {
        "description": "浅灰蓝面板底，无网格，柔和分区",
        "spines": ["left", "bottom"],
        "spine_width": 0.8,
        "tick_direction": "out",
        "tick_length": 3.0,
        "grid": "none",
        "canvas": "soft_tint",
        "legend_frame": false
      }
    },
    "knobs": {
      "border": ["open", "journal"],
      "grid": ["none", "y", "both"],
      "line_width": ["thin", "regular", "bold"],
      "font_size": ["small", "regular", "large"],
      "legend_frame": [false, true],
      "canvas": ["white", "soft_tint"]
    },
    "line_widths": {
      "thin": 0.8,
      "regular": 1.1,
      "bold": 1.5
    },
    "tick_width": 0.8,
    "grid_alpha": 0.35,
    "grid_linewidth": 0.6,
    "axes_facecolor": "inherit"
  },
  "marks": {
    "fill_alpha": 0.18,
    "edge_alpha": 1.0,
    "edge_width": 1.0,
    "marker_edge": "#FFFFFF",
    "marker_edge_width": 0.6,
    "band_alphas": [0.08, 0.12, 0.18],
    "jitter_width": 0.09,
    "scatter_size": 14.0,
    "violin_alpha": 0.22,
    "box_alpha": 0.30,
    "mean_line": {
      "color": "#6B7280",
      "linestyle": "--",
      "linewidth": 0.9
    },
    "zero_line": {
      "color": "#9CA3AF",
      "linewidth": 0.8
    },
    "annotation_box": {
      "facecolor": "#FFFFFF",
      "edgecolor": "#D1D5DB",
      "linewidth": 0.6,
      "boxstyle": "round,pad=0.3"
    }
  },
  "figure": {
    "single_column_mm": 89,
    "double_column_mm": 183,
    "default_width_mm": 160,
    "slide_16_9_mm": [338.7, 190.5],
    "a4_portrait_mm": [210, 297],
    "export": {
      "vector": ["pdf", "svg"],
      "raster_dpi": [300, 600],
      "preview_dpi": 300
    },
    "default_aspect": 0.62
  },
  "rules": {
    "zero_baseline": true,
    "pie_max_categories": 6,
    "direct_label_max_series": 5,
    "horizontal_label_units": 12,
    "horizontal_category_count": 5,
    "max_grid_contrast_ratio": 0.15,
    "min_text_contrast_wcag": 4.5,
    "min_graphic_contrast_wcag": 3.0,
    "cvd_min_delta_e": 10.0,
    "duplicate_delta_e": 5.0,
    "max_palette_categories": 8,
    "max_questions": 3,
    "manifest_min_figures": 3
  },
  "scene_slots": [
    "title",
    "canvas_ratio",
    "color_strategy",
    "typography",
    "axes_grid",
    "annotation",
    "preferred_charts",
    "interaction",
    "delivery",
    "provenance",
    "accessibility",
    "prohibitions"
  ],
  "scenes": {
    "academic": {
      "palette": "okabe_ito",
      "layout_family": "clean_open",
      "in_canvas_title": false,
      "width_mm": 89,
      "double_column_mm": 183,
      "aspect": 0.68,
      "font_size_level": "small",
      "formats": ["pdf", "svg", "png"],
      "dpi": [300, 600],
      "top_no_title": 0.93
    },
    "bi": {
      "palette": "bi_ibcs",
      "layout_family": "soft_grid",
      "in_canvas_title": true,
      "width_mm": 180,
      "aspect": 0.58,
      "font_size_level": "regular",
      "formats": ["pdf", "png"],
      "dpi": [300]
    },
    "story": {
      "palette": "editorial_warm",
      "layout_family": "clean_open",
      "in_canvas_title": true,
      "focal_context_only": true,
      "width_mm": 254,
      "aspect": 0.5625,
      "font_size_level": "large",
      "formats": ["svg", "png"],
      "dpi": [300, 600]
    },
    "geo": {
      "palette": "met_egypt",
      "layout_family": "clean_open",
      "in_canvas_title": true,
      "width_mm": 170,
      "aspect": 0.72,
      "font_size_level": "regular",
      "formats": ["svg", "png"],
      "dpi": [300]
    }
  }
}
