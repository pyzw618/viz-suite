# viz-suite · ieee_serif
# 派生自 SciencePlots (MIT) 的 journals/ieee.mplstyle，去除 Times 专有字体硬编码。
# 来源：https://github.com/garrettj403/SciencePlots  (MIT)
axes.prop_cycle: (cycler('color', ['k', 'r', 'b', 'g']) + cycler('ls', ['-', '--', ':', '-.']))
figure.figsize: 3.3, 2.5
figure.dpi: 300
font.size: 8
font.family: serif
font.serif: Times New Roman, SimSun, STSong, DejaVu Serif, serif
axes.unicode_minus: False
axes.linewidth: 0.6
lines.linewidth: 1.0
legend.frameon: False
pdf.fonttype: 42
ps.fonttype: 42
