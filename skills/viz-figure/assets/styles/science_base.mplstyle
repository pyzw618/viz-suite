# viz-suite · science_base
# 派生自 SciencePlots (MIT) 的 science.mplstyle，去除 LaTeX 依赖、专有字体与 tight bbox。
# 来源：https://github.com/garrettj403/SciencePlots  (MIT)
axes.prop_cycle: cycler('color', ['0C5DA5', '00B945', 'FF9500', 'FF2C00', '845B97', '474747'])
figure.figsize: 3.5, 2.625
figure.dpi: 110
xtick.direction: in
xtick.major.size: 3
xtick.major.width: 0.5
xtick.minor.size: 1.5
xtick.minor.width: 0.5
xtick.minor.visible: True
xtick.top: True
ytick.direction: in
ytick.major.size: 3
ytick.major.width: 0.5
ytick.minor.size: 1.5
ytick.minor.width: 0.5
ytick.minor.visible: True
ytick.right: True
axes.linewidth: 0.5
grid.linewidth: 0.5
lines.linewidth: 1.0
legend.frameon: False
font.family: sans-serif
font.sans-serif: Arial, Helvetica, Microsoft YaHei, SimHei, DejaVu Sans, sans-serif
axes.unicode_minus: False
mathtext.fontset: dejavusans
pdf.fonttype: 42
ps.fonttype: 42
